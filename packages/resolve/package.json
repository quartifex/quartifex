{
  "name": "@quartifex/resolve",
  "version": "0.0.0",
  "description": "A resolution ladder as data: picks the sequence tier, canvas pixel ratio, texture and shadow-map size from CSS pixels, DPR, GPU tier and connection, and explains every choice.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./gpu": {
      "types": "./dist/gpu.d.ts",
      "import": "./dist/gpu.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quartifex/quartifex.git",
    "directory": "packages/resolve"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "size-limit"
  },
  "peerDependencies": {
    "detect-gpu": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "detect-gpu": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/file": "^14.1.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "size-limit": "^14.1.0",
    "typescript": "^7.0.2"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "limit": "3 kB"
    },
    {
      "name": "react adapter",
      "path": "dist/react.js",
      "limit": "1 kB"
    },
    {
      "name": "gpu",
      "path": "dist/gpu.js",
      "limit": "0.5 kB"
    }
  ],
  "keywords": [
    "responsive",
    "dpr",
    "image-sequence",
    "network-information",
    "save-data",
    "detect-gpu",
    "three",
    "performance"
  ],
  "dependencies": {
    "@quartifex/rushes": "workspace:^"
  }
}
