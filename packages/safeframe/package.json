{
  "name": "@quartifex/safeframe",
  "version": "0.0.0",
  "description": "Art-directed staging for scroll and 3D scenes on every screen: focal-point crops, subject-safe camera fits and text zones per aspect bucket.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quartifex/quartifex.git",
    "directory": "packages/safeframe"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "size-limit"
  },
  "peerDependencies": {
    "gsap": "^3.12.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/file": "^14.1.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "size-limit": "^14.1.0",
    "typescript": "^7.0.2",
    "three": "^0.186.1",
    "@types/three": "^0.186.0"
  },
  "size-limit": [
    {
      "name": "core",
      "path": [
        "dist/index.js",
        "dist/frame.js",
        "dist/camera.js"
      ],
      "limit": "5 kB"
    },
    {
      "name": "react adapter",
      "path": "dist/react.js",
      "limit": "1 kB"
    }
  ],
  "keywords": [
    "responsive",
    "art-direction",
    "focal-point",
    "crop",
    "camera",
    "three",
    "r3f",
    "scrollytelling",
    "aspect-ratio"
  ],
  "dependencies": {
    "@quartifex/plumb": "workspace:^"
  }
}
