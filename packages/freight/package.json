{
  "name": "@quartifex/freight",
  "version": "0.0.0",
  "description": "An opinionated glTF-Transform preset with a verdict: dedupe, prune, weld, texture caps and re-encoding (WebP, AVIF, KTX2), Meshopt or Draco, naming rules, a budget pass or fail, a Markdown report and a typed React Three Fiber module.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quartifex/quartifex.git",
    "directory": "packages/freight"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "size-limit"
  },
  "peerDependencies": {
    "meshoptimizer": ">=0.20.0",
    "draco3dgltf": "^1.5.7",
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "meshoptimizer": {
      "optional": true
    },
    "draco3dgltf": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/file": "^14.1.0",
    "size-limit": "^14.1.0",
    "typescript": "^7.0.2",
    "meshoptimizer": "^1.3.0",
    "draco3dgltf": "^1.5.7",
    "sharp": "^0.35.5",
    "@types/node": "^22.20.4"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "limit": "6 kB"
    },
    {
      "name": "node runner",
      "path": "dist/node.js",
      "limit": "3 kB"
    },
    {
      "name": "browser runner",
      "path": "dist/browser.js",
      "limit": "1.5 kB"
    }
  ],
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1"
  },
  "bin": {
    "freight": "./dist/cli.js"
  },
  "keywords": [
    "gltf",
    "glb",
    "gltf-transform",
    "meshopt",
    "draco",
    "ktx2",
    "three",
    "react-three-fiber",
    "budget"
  ]
}
