{
  "name": "@quartifex/stillness",
  "version": "0.0.0",
  "description": "A motion policy for cinematic pages: every effect declares full, reduced and static behaviour; plus a chapter rail, skip links, focus management, live progress and Save-Data handling.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quartifex/quartifex.git",
    "directory": "packages/stillness"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "size-limit"
  },
  "peerDependencies": {
    "gsap": "^3.12.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/file": "^14.1.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "size-limit": "^14.1.0",
    "typescript": "^7.0.2"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "limit": "2 kB"
    },
    {
      "name": "dom kit",
      "path": "dist/dom.js",
      "limit": "2 kB"
    },
    {
      "name": "react adapter",
      "path": "dist/react.js",
      "limit": "1 kB"
    }
  ],
  "keywords": [
    "accessibility",
    "a11y",
    "prefers-reduced-motion",
    "save-data",
    "scrollytelling",
    "aria-live",
    "skip-link"
  ]
}
