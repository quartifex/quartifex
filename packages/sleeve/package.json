{
  "name": "@quartifex/sleeve",
  "version": "0.0.0",
  "description": "Labels for jars, bottles and cans in three.js and React Three Fiber: wrap coverage and seam control, distortion-free mapping on tapered vessels, the die-line as SVG, decals, and gloss, satin, matte, foil and spot-varnish layers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quartifex/quartifex.git",
    "directory": "packages/sleeve"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "three": ">=0.156.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.1",
    "@size-limit/file": "^14.1.0",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "react": "^19.3.0",
    "size-limit": "^14.1.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "limit": "3.5 kB"
    },
    {
      "name": "three binding",
      "path": "dist/three.js",
      "limit": "1.5 kB"
    },
    {
      "name": "r3f component",
      "path": "dist/react.js",
      "limit": "1 kB"
    }
  ],
  "keywords": [
    "three",
    "react-three-fiber",
    "r3f",
    "label",
    "packaging",
    "dieline",
    "uv-mapping",
    "product"
  ]
}
