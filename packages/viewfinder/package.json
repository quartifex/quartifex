{
  "name": "@quartifex/viewfinder",
  "version": "0.0.0",
  "description": "A devtools overlay for scrollytelling: chapters with jump-to, progress per scene, sequence frame and buffer, fps and long-frame graph, trigger markers, and record-and-replay of a scroll path.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gsap": {
      "types": "./dist/gsap.d.ts",
      "import": "./dist/gsap.js"
    },
    "./reel": {
      "types": "./dist/reel.d.ts",
      "import": "./dist/reel.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quartifex/quartifex.git",
    "directory": "packages/viewfinder"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "size-limit"
  },
  "peerDependencies": {
    "gsap": "^3.12.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/file": "^14.1.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "size-limit": "^14.1.0",
    "typescript": "^7.0.2"
  },
  "size-limit": [
    {
      "name": "overlay",
      "path": [
        "dist/index.js",
        "dist/record.js"
      ],
      "limit": "6 kB"
    },
    {
      "name": "gsap source",
      "path": "dist/gsap.js",
      "limit": "0.5 kB"
    },
    {
      "name": "reel source",
      "path": "dist/reel.js",
      "limit": "0.5 kB"
    },
    {
      "name": "react adapter",
      "path": "dist/react.js",
      "limit": "0.5 kB"
    }
  ],
  "keywords": [
    "devtools",
    "overlay",
    "scrollytelling",
    "gsap",
    "scrolltrigger",
    "image-sequence",
    "performance",
    "debug"
  ],
  "dependencies": {
    "@quartifex/reel": "workspace:^",
    "@quartifex/spine": "workspace:^"
  }
}
