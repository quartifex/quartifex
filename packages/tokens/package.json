{
  "name": "@quartifex/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Quartifex brand tokens as CSS custom properties. Internal for now; becomes `restraint` (L20).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "tokens.css",
      "path": "src/tokens.css",
      "limit": "2 kB"
    }
  ],
  "devDependencies": {
    "@size-limit/file": "^14.1.0",
    "@types/node": "^22.20.4",
    "size-limit": "^14.1.0",
    "typescript": "^7.0.2"
  }
}
