{
  "name": "@quartifex/understudy",
  "version": "0.0.0",
  "description": "A quality governor with a contract: WebGL, then image sequence, then poster. Device tiers at start, frame-rate adaptation of pixel ratio, shadows, post-processing and particles at runtime, and an automatic hand-off to reel.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./r3f": {
      "types": "./dist/r3f.d.ts",
      "import": "./dist/r3f.js"
    },
    "./reel": {
      "types": "./dist/reel.d.ts",
      "import": "./dist/reel.js"
    },
    "./gpu": {
      "types": "./dist/gpu.d.ts",
      "import": "./dist/gpu.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quartifex/quartifex.git",
    "directory": "packages/understudy"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "detect-gpu": "^5.0.0",
    "react": "^19.0.0",
    "three": ">=0.156.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "detect-gpu": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.1",
    "@size-limit/file": "^14.1.0",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "react": "^19.3.0",
    "size-limit": "^14.1.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "limit": "4 kB"
    },
    {
      "name": "react adapter",
      "path": "dist/react.js",
      "limit": "1 kB"
    },
    {
      "name": "r3f governor",
      "path": "dist/r3f.js",
      "limit": "1 kB"
    },
    {
      "name": "reel hand-off",
      "path": "dist/reel.js",
      "limit": "1 kB"
    },
    {
      "name": "gpu",
      "path": "dist/gpu.js",
      "limit": "0.5 kB"
    }
  ],
  "dependencies": {
    "@quartifex/reel": "workspace:^",
    "@quartifex/resolve": "workspace:^",
    "@quartifex/rushes": "workspace:^"
  },
  "keywords": [
    "webgl",
    "fallback",
    "performance",
    "fps",
    "adaptive-quality",
    "three",
    "react-three-fiber",
    "image-sequence",
    "scrollytelling"
  ]
}
