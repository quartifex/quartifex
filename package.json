{
  "name": "quartifex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest run",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "size": "turbo run size",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm size",
    "e2e": "pnpm --filter @quartifex/lab e2e",
    "new:lib": "node scripts/new-lib.mjs",
    "new:site": "node scripts/new-site.mjs",
    "status": "node scripts/status-table.mjs",
    "fonts": "node scripts/sync-fonts.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@size-limit/file": "^14.1.0",
    "@types/node": "^22.20.4",
    "size-limit": "^14.1.0",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
