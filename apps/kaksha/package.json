{
  "name": "@quartifex/site-kaksha",
  "version": "0.0.0",
  "private": true,
  "description": "kaksha (S20): an offline-first marking app for teachers, and its one-page site. Free tool.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.mjs && node scripts/build-app.mjs --dev && next dev --port 3500",
    "build": "node scripts/prepare.mjs && node scripts/build-app.mjs && node scripts/sw.mjs && next build",
    "start": "next start --port 3500",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "timing": "playwright test e2e/timing.spec.ts",
    "sheet": "node scripts/sheet.mjs",
    "heft": "node scripts/heft.mjs",
    "a11y": "node scripts/audit.mjs",
    "build:app": "node scripts/build-app.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@quartifex/stillness": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "gsap": "^3.15.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@quartifex/contactsheet": "workspace:*",
    "@quartifex/heft": "workspace:*",
    "@serwist/build": "^9.5.13",
    "@tabler/icons": "^3.49.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "harfbuzzjs": "^1.6.3",
    "lighthouse": "^13.5.0",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "wawoff2": "^2.0.1"
  }
}
