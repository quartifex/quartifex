{
  "name": "@quartifex/site-anyframe",
  "version": "0.0.0",
  "private": true,
  "description": "anyframe (S13): Responsive proof. Open-source demo.",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/sync-fonts.mjs && node scripts/sequence.mjs && next dev --port 3200",
    "build": "node ../../scripts/sync-fonts.mjs && node scripts/sequence.mjs && next build",
    "start": "next start --port 3200",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "sheet": "node scripts/sheet.mjs",
    "heft": "node scripts/heft.mjs"
  },
  "dependencies": {
    "@quartifex/contactsheet": "workspace:*",
    "@quartifex/plumb": "workspace:*",
    "@quartifex/reel": "workspace:*",
    "@quartifex/resolve": "workspace:*",
    "@quartifex/rushes": "workspace:*",
    "@quartifex/safeframe": "workspace:*",
    "@quartifex/tokens": "workspace:*",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "@quartifex/heft": "workspace:*"
  }
}
