{
  "name": "@quartifex/site-avenue",
  "version": "0.0.0",
  "private": true,
  "description": "avenue (S20): AVENUE, a whole-car infotainment concept: a playable demo in a 3D cabin, a product page for partners, and the system's documentation. Personal Concept.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/assets.mjs && next dev --port 3500",
    "build": "node scripts/assets.mjs && next build",
    "start": "next start --port 3500",
    "assets": "node scripts/assets.mjs --force",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "sheet": "node scripts/sheet.mjs",
    "heft": "node scripts/heft.mjs",
    "a11y": "node scripts/audit.mjs"
  },
