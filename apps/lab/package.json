{
  "name": "@quartifex/lab",
  "version": "0.0.0",
  "private": true,
  "description": "The Quartifex Lab hub (lab.quartifex.com): every library, proof site and Lab seed in one catalog.",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/sync-fonts.mjs && node scripts/sequence.mjs && next dev --port 3100",
    "build": "node ../../scripts/sync-fonts.mjs && node scripts/sequence.mjs && next build",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@quartifex/contactsheet": "workspace:*",
    "@quartifex/dailies": "workspace:*",
    "@quartifex/plumb": "workspace:*",
    "@quartifex/reel": "workspace:*",
    "@quartifex/resolve": "workspace:*",
    "@quartifex/rushes": "workspace:*",
    "@quartifex/safeframe": "workspace:*",
    "@quartifex/stillness": "workspace:*",
    "@quartifex/tokens": "workspace:*",
    "detect-gpu": "^5.0.70",
    "gsap": "^3.15.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
